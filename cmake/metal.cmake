if(NOT APPLE OR NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$")
  message(FATAL_ERROR "UOCR_WITH_METAL requires native Apple Silicon, not Rosetta")
endif()
enable_language(OBJCXX)
set(CMAKE_OBJCXX_STANDARD 23)
set(CMAKE_OBJCXX_STANDARD_REQUIRED ON)
add_library(uocr_metal_gemm STATIC src/backend/metal/gemm.mm)
target_include_directories(uocr_metal_gemm PUBLIC src)
target_compile_options(uocr_metal_gemm PRIVATE -fobjc-arc)
target_link_libraries(uocr_metal_gemm PUBLIC uocr_flags
  "-framework Foundation" "-framework Metal" "-framework MetalPerformanceShaders")
if(BUILD_TESTING)
  add_executable(metal_gemm_test tests/metal_gemm_test.cpp)
  target_include_directories(metal_gemm_test PRIVATE tests)
  target_link_libraries(metal_gemm_test PRIVATE uocr_metal_gemm uocr_reference)
  add_test(NAME metal_gemm_test COMMAND metal_gemm_test)
  set_tests_properties(metal_gemm_test PROPERTIES SKIP_RETURN_CODE 77 TIMEOUT 60)
endif()
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/src/backend/metal/kernels.metal" UOCR_METAL_SOURCE)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS src/backend/metal/kernels.metal)
configure_file(cmake/metal_source.h.in generated-metal/metal_source.h @ONLY)
add_library(uocr_metal STATIC src/backend/metal/context.mm src/backend/metal/ops.mm)
target_include_directories(uocr_metal PUBLIC src PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated-metal")
target_compile_options(uocr_metal PRIVATE -fobjc-arc)
target_link_libraries(uocr_metal PUBLIC uocr_weights "-framework Foundation" "-framework Metal" "-framework MetalPerformanceShaders")
add_library(uocr_metal_model STATIC src/model/metal/metal_vision.cpp src/model/metal/metal_decoder.cpp src/model/metal/device_weight.cpp)
target_link_libraries(uocr_metal_model PUBLIC uocr_reference uocr_metal)
if(BUILD_TESTING)
  foreach(test_name metal_ops_test metal_vision_test metal_decoder_test metal_golden_test)
    add_executable(${test_name} tests/${test_name}.cpp)
    target_include_directories(${test_name} PRIVATE tests)
    target_link_libraries(${test_name} PRIVATE uocr_metal_model)
    target_compile_definitions(${test_name} PRIVATE UOCR_GOLDENS="${CMAKE_CURRENT_SOURCE_DIR}/tests/goldens")
    add_test(NAME ${test_name} COMMAND ${test_name})
    set_tests_properties(${test_name} PROPERTIES SKIP_RETURN_CODE 77 TIMEOUT 1800)
  endforeach()
endif()
target_link_libraries(uocr-run PRIVATE uocr_metal_model)
target_compile_definitions(uocr-run PRIVATE UOCR_WITH_METAL=1)
if(BUILD_TESTING)
  set_tests_properties(metal_ops_test metal_vision_test metal_decoder_test PROPERTIES TIMEOUT 60)
endif()
if(BUILD_TESTING)
  set_tests_properties(metal_golden_test PROPERTIES TIMEOUT 900)
endif()
