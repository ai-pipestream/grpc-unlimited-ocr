# syntax=docker/dockerfile:1.28
# Candidate base pins from the sibling SYCL recipes. Hash verification below
# deliberately fails if their compiler/runtime differs from native qualification.
ARG ONEAPI_IMAGE=intel/oneapi-basekit:2025.3.2-0-devel-ubuntu24.04@sha256:79a5e333ff6f773793d124b78047001c51cbcd53035e5100313abf2f771af95a
ARG UBUNTU_IMAGE=ubuntu:26.10@sha256:262df65c0ec6bf8d9dcc87454f4330a05fae4b97825f45854af3b136666584c2
FROM ${ONEAPI_IMAGE} AS oneapi
FROM ${UBUNTU_IMAGE} AS build
ARG BUILD_JOBS=2
RUN test "$BUILD_JOBS" = 1 || test "$BUILD_JOBS" = 2
COPY --from=oneapi /opt/intel/oneapi /opt/intel/oneapi
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates cmake g++ git ninja-build libze-dev=1.32.0-1 \
    && rm -rf /var/lib/apt/lists/*
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /src
COPY . .
RUN sha256sum -c scripts/intel-qualified-toolchain.sha256
# Keep bundled BoringSSL, as in the qualified native build. No OpenSSL4 patch
# or system-provider substitution is hidden in the container build.
RUN source /opt/intel/oneapi/setvars.sh >/dev/null 2>&1 \
 && cmake -S . -B /build -G Ninja -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_C_COMPILER=icx -DCMAKE_CXX_COMPILER=icpx \
      -DUOCR_WITH_INTEL=ON -DUOCR_WITH_CUDA=OFF -DUOCR_WITH_SERVER=ON \
      -DBUILD_TESTING=ON -DgRPC_SSL_PROVIDER=module
RUN source /opt/intel/oneapi/setvars.sh >/dev/null 2>&1 \
 && nice -n10 cmake --build /build --parallel "$BUILD_JOBS" \
 && ctest --test-dir /build --output-on-failure -R '^(config_test|service_test|model_document_checks_test|intel_native_rpc_assertions_test|fixture_content_assertions)$' \
 && mkdir -p /receipts \
 && cp /build/CMakeCache.txt /build/build.ninja /receipts/ \
 && dpkg-query -W > /receipts/build-packages.txt \
 && icpx --version > /receipts/compiler.txt \
 && git -C /build/_deps/grpc-src rev-parse HEAD > /receipts/grpc.txt \
 && git -C /build/_deps/grpc-src submodule status --recursive > /receipts/grpc-submodules.txt \
 && sha256sum /build/grpc-unlimited-ocr-server /build/intel_native_rpc_test /build/intel_native_golden_test > /receipts/binaries.sha256

FROM ${UBUNTU_IMAGE} AS runtime
ARG UOCR_REVISION
LABEL org.opencontainers.image.revision=${UOCR_REVISION}
RUN apt-get update && apt-get install -y --no-install-recommends \
    libstdc++6 libgomp1 libze1=1.32.0-1 \
    libze-intel-gpu1=26.27.39122.14-1 intel-opencl-icd=26.27.39122.14-1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=oneapi /opt/intel/oneapi/compiler/2025.3/lib /opt/intel/oneapi/compiler/2025.3/lib
COPY --from=oneapi /opt/intel/oneapi/dnnl/2025.3/lib /opt/intel/oneapi/dnnl/2025.3/lib
COPY --from=oneapi /opt/intel/oneapi/tbb/2022.3/lib /opt/intel/oneapi/tbb/2022.3/lib
COPY --from=oneapi /opt/intel/oneapi/tcm/1.4/lib /opt/intel/oneapi/tcm/1.4/lib
COPY --from=oneapi /opt/intel/oneapi/umf/1.0/lib /opt/intel/oneapi/umf/1.0/lib
COPY --from=build /build/grpc-unlimited-ocr-server /usr/local/bin/grpc-unlimited-ocr-server
COPY --from=build /build/uocr-run /usr/local/bin/uocr-run
COPY --from=build /receipts /usr/share/uocr/receipts
COPY LICENSE NOTICE /usr/share/uocr/
ENV LD_LIBRARY_PATH=/opt/intel/oneapi/compiler/2025.3/lib:/opt/intel/oneapi/dnnl/2025.3/lib:/opt/intel/oneapi/tbb/2022.3/lib/intel64/gcc4.8:/opt/intel/oneapi/tcm/1.4/lib:/opt/intel/oneapi/umf/1.0/lib \
    ONEAPI_DEVICE_SELECTOR=level_zero:gpu GRPC_UOCR_BACKEND=intel-gpu \
    GRPC_UOCR_WEIGHT_FORMAT=bf16 GRPC_UOCR_DEVICE_MEMORY_CAP=12884901888 \
    GRPC_UOCR_MODELS_DIR=/models GRPC_UOCR_LISTEN_ADDRESS=0.0.0.0:50073 \
    HOME=/tmp SYCL_CACHE_DIR=/tmp/sycl-cache
USER 65532:65532
EXPOSE 50073
ENTRYPOINT ["/usr/local/bin/grpc-unlimited-ocr-server"]

# Same server and runtime layers; extra test binaries only. No weights included.
FROM runtime AS qualification
COPY --from=build /build/intel_native_rpc_test /build/intel_native_golden_test /build/intel_memory_check /usr/local/bin/
COPY tests/goldens /src/tests/goldens
